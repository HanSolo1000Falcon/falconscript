!! This is a comment
!/
This is a block comment
/!

fn main(args: immut str[]) ret int {
    var x: int = 1 + 3 - 5 * 3 / (1 + 2);
    std:println("{}", x);
    x = x + 1;
    std:println("{}", x);
    std:print("Hello, ");
    std:println("world!");
    std:println(concat_string("This is", " falconscript!"));

    var y: str = none;
    if std:random() > 0.5 {
        y = "This is a string";
    }

    if args:len() > 0 {
        std:println("{}", std:read_from_file(args:at(0)));
    }

    if y == none {
        std:println("y is none");
    } else {
        std:println("y is not none");
    }

    if true {} elif false {} else {}

    var user_input: str = std:getln();
    std:println("You entered: {}", user_input);

    var a: int = -1;
    var b: float = 2.0;
    std:println("{} + {} = {}", a, b, a + b);

    for i: int in 0..10 {
        std:println("{}", i);
    }

    var str_arr: str[] = ["Hello", "This is falconscript", "Falconscript is cool"];
    for s: str in str_arr {
        std:println(s);
    }

    var should_break: bool = false;
    while true {
        std:println("Should we break out of this loop? {}", should_break);
        should_break = std:random() > 0.5;
        if should_break {
            break;
        }
    }

    for arg: str in args {
        std:println(arg);
    }

    std:println("arg length: {}", args:len());

    if true and not (false or not true or true != true) {
        std:println("true");
    }

    str_arr:push("This is a new string");
    std:println("{}", str_arr:len());
    str_arr:rm(0);
    std:println("{}", str_arr:len());
    std:println("{}", str_arr:at(0));

    if std:random() > 0.5 {
        std:println("true");
    } elif std:random() > 0.25 {
        std:println("maybe");
    } else {
        std:println("false");
    }

    if std:random() > 0.5 {
        std:exit(0, "Exiting with code 0");
    } elif std:random() > 0.25 {
        std:exit(1, "Exiting with code 1");
    }

    ret 0;
}

fn concat_string(a: str, b: str) ret str {
    ret a + b;
}

fn print_this(to_print: str) ret void {
    std:println(to_print);
}